# CampaignPilot AI environment example

APP_NAME=CampaignPilot AI
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
POSTGRES_DB=campaignpilot
POSTGRES_USER=campaignpilot
POSTGRES_PASSWORD=campaignpilot
DATABASE_URL=postgresql+psycopg://campaignpilot:campaignpilot@postgres:5432/campaignpilot

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_DOCUMENT_INDEX=campaignpilot_document_chunks

# OpenAI / LLM
OPENAI_API_KEY=replace_me
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_DEFAULT_CHAT_ID=replace_me

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
